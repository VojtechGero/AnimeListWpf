<UserControl x:Class="AnimeListWpf.Views.UserControls.DescriptionUiSegment"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnimeListWpf.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800">
    <Border Height="auto" Margin="4" CornerRadius="10"
             BorderThickness="2" BorderBrush="White" Background="#FF20262A" >
        <Grid Background="#FF20262A" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition  Height="auto" />
                <RowDefinition  Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Description" Foreground="White" Padding="10" 
               FontSize="20" VerticalAlignment="Center" Grid.Row="0" 
               Name="TitleTextBox"/>
            <WrapPanel Grid.Row="1" 
               Name="DescriptionWrapPanel" VerticalAlignment="Center">
                <d:Border CornerRadius="10" BorderThickness="10" BorderBrush="Gray">
                    <d:TextBlock Text="Text" Foreground="Black" Padding="10" 
                FontSize="20" VerticalAlignment="Center" Background="Gray"/>
                </d:Border>

            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
