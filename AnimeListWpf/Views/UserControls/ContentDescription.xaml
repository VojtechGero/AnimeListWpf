<UserControl x:Class="AnimeListWpf.Views.UserControls.ContentDescription"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnimeListWpf.Views.UserControls"
             mc:Ignorable="d" 
                Foreground="White"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Image HorizontalAlignment="Center" Margin="0,10,0,10"
                Source="../../Images/MyAnimeList_Logo.png" 
                Height="40" Width="40" 
                Name="MalLogo" Cursor="Hand"
                ToolTip="My Anime List" MouseLeftButtonDown="MalLogo_MouseLeftButtonDown"
            />
            <TextBlock Grid.Column="1" 
                VerticalAlignment="Center"
                HorizontalAlignment="Left" Margin="10"
                FontSize="25" Name="NameLabel"
                ToolTip="Click to Copy" Cursor="Hand" 
                MouseLeftButtonDown="NameLabel_MouseLeftButtonDown" 
                Foreground="White"
                Text="{Binding Name}"
                />
        </Grid>
        <!-- Description body -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" MaxHeight="40"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="20" Name="OtherNameLabel"
                       Text="{Binding OtherName, StringFormat=({0})}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OtherName}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="1" Text="Description" Margin="10" 
            VerticalAlignment="Top" HorizontalAlignment="Left"
            Name="Description" FontSize="20" Foreground="White"/>
        </Grid>
    </Grid>
</UserControl>
